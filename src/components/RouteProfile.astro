---
interface Props {
  profile: number[];
  class?: string;
  color?: string;
}

const { profile, class: className, color = '#123F52' } = Astro.props;
const width = 640;
const height = 240;
const pad = 24;
const min = Math.min(...profile);
const max = Math.max(...profile);
const range = max - min || 1;

const points = profile.map((value, index) => {
  const x = pad + (index * (width - pad * 2)) / (profile.length - 1);
  const y = height - pad - ((value - min) / range) * (height - pad * 2);
  return [x, y] as const;
});

const line = points
  .map(([x, y], index) => `${index === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`)
  .join(' ');
const area = `${line} L${width - pad} ${height} L${pad} ${height} Z`;
const accent = points[Math.floor(points.length / 2)];
---

<svg
  class={className}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="none"
  role="img"
  aria-hidden="true"
>
  <rect width={width} height={height} fill={color} />
  <line class="art-grid" x1={pad} y1={height - pad} x2={width - pad} y2={height - pad} />
  <line class="art-grid" x1={width / 3} y1="16" x2={width / 3} y2={height - pad} opacity="0.5" />
  <line class="art-grid" x1={(width / 3) * 2} y1="16" x2={(width / 3) * 2} y2={height - pad} opacity="0.5" />
  <path class="art-fill" d={area} />
  <path class="art-line" d={line} />
  <circle class="art-dot" cx={accent[0]} cy={accent[1]} r="6" />
</svg>
