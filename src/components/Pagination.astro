---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages, basePath = '/diario/' } = Astro.props;

const urlFor = (page: number) =>
  page === 1 ? basePath : `${basePath}pagina/${page}/`;
---

<nav class="pagination" aria-label="Paginación">
  <div>
    {currentPage > 1 ? (
      <a href={urlFor(currentPage - 1)}>Anterior</a>
    ) : (
      <span class="disabled">Anterior</span>
    )}
  </div>

  <ol class="pagination__pages">
    {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
      <li>
        {page === currentPage ? (
          <span aria-current="page">{page}</span>
        ) : (
          <a href={urlFor(page)} aria-label={`Página ${page}`}>{page}</a>
        )}
      </li>
    ))}
  </ol>

  <div>
    {currentPage < totalPages ? (
      <a href={urlFor(currentPage + 1)}>Siguiente</a>
    ) : (
      <span class="disabled">Siguiente</span>
    )}
  </div>
</nav>
