---
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT;
---

<aside class="ad" aria-label="Publicidad">
  <p class="ad__label">Publicidad</p>

  {client && slot ? (
    <>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </>
  ) : (
    <div class="ad__box">
      <p class="ad__placeholder">Espacio reservado para publicidad.</p>
    </div>
  )}
</aside>
