---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { AUTOR } from '../../data/autor';
import { SITE } from '../../data/site';
import { sortByDate } from '../../lib/utils';

export function getStaticPaths() {
  return [{ params: { slug: AUTOR.slug } }];
}

const articulos = sortByDate(await getCollection('articulos'));
const site = Astro.site ?? new URL(SITE.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTOR.name,
  jobTitle: AUTOR.role,
  description: AUTOR.bio,
  url: new URL(`/autor/${AUTOR.slug}/`, site).toString(),
  email: AUTOR.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Madrid',
    addressCountry: 'ES',
  },
};
---

<BaseLayout
  title={`${AUTOR.name}, autor de Ruta y Ritmo`}
  description={`Perfil de ${AUTOR.name}, editor de Ruta y Ritmo. Artículos de running, rutas y material.`}
  jsonLd={[jsonLd]}
>
  <div class="wrap page">
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: '/' },
        { label: 'Autor', href: '/sobre/' },
        { label: AUTOR.name },
      ]}
    />

    <header class="page__header">
      <div class="article-kicker">
        <span class="category-tag" style="--cat: var(--primary)">Autor</span>
        <span>{articulos.length} artículos publicados</span>
      </div>
      <h1>{AUTOR.name}</h1>
      <p>{AUTOR.role}. {AUTOR.location}.</p>
    </header>

    <div class="prose">
      {AUTOR.longBio.map((paragraph) => <p>{paragraph}</p>)}
      <p>
        Puedes escribir a <a href={`mailto:${AUTOR.email}`}>{AUTOR.email}</a> o usar el
        <a href="/contacto/">formulario de contacto</a>. Para saber cómo se trabaja en el
        sitio, consulta la <a href="/politica-editorial/">política editorial</a>.
      </p>
    </div>

    <section class="section" aria-labelledby="articulos-autor">
      <div class="section-head">
        <h2 id="articulos-autor">Artículos de {AUTOR.name}</h2>
        <p>Todo lo publicado en el diario, de lo más reciente a lo más antiguo.</p>
      </div>

      <div class="card-grid">
        {articulos.map((entry) => <ArticleCard entry={entry} />)}
      </div>
    </section>
  </div>
</BaseLayout>
