---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Gracias"
  description="Mensaje recibido. Gracias por escribir a Ruta y Ritmo."
  noindex
>
  <div class="wrap not-found">
    <h1>Gracias.</h1>
    <p>
      He recibido tu mensaje. Si era para el boletín, lo confirmaré por correo; si era una
      corrección o una propuesta, lo leeré con calma y responderé en la medida de lo posible.
    </p>
    <div class="not-found__links">
      <a class="button" href="/diario/">Volver al diario</a>
      <a class="text-link" href="/">Ir al inicio</a>
    </div>
  </div>
</BaseLayout>
