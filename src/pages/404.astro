---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o se ha movido."
  noindex
>
  <div class="wrap not-found">
    <h1>404</h1>
    <p>
      Esta página no existe, se ha movido o nunca llegó a la meta. Puedes volver al
      diario, revisar las rutas o buscar lo que necesitas.
    </p>
    <div class="not-found__links">
      <a class="button" href="/diario/">Ir al diario</a>
      <a class="text-link" href="/rutas/">Ver rutas</a>
      <a class="text-link" href="/buscar/">Buscar</a>
    </div>
  </div>
</BaseLayout>
