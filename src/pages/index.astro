---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import { CATEGORIAS } from '../data/categorias';
import { SITE } from '../data/site';
import { readingTime, sortByDate } from '../lib/utils';

const articulos = sortByDate(await getCollection('articulos'));
const rutas = sortByDate(await getCollection('rutas'));

const destacado = articulos.find((entry) => entry.data.featured) ?? articulos[0];
const ultimos = articulos.filter((entry) => entry.id !== destacado.id).slice(0, 6);

const site = Astro.site ?? new URL(SITE.url);
const categoriaDestacada = CATEGORIAS[destacado.data.category];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: site.toString(),
    description: SITE.description,
    inLanguage: 'es-ES',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${site.toString()}buscar/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: site.toString(),
    email: SITE.email,
    description: SITE.description,
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div>
      <h1 id="hero-title">El asfalto también se lee.</h1>
      <p class="hero__lede">
        Rutas, entrenamiento y material para corredores populares. Ideas prácticas,
        fuentes a la vista y ningún plan milagro.
      </p>
      <div class="hero__actions">
        <a class="button" href="/diario/">Leer el diario</a>
        <a class="text-link" href="/rutas/">Ver las rutas</a>
      </div>
      <p class="hero__note">
        {articulos.length} artículos, {rutas.length} rutas y ningún plan milagro.
      </p>
    </div>

    <figure class="bib" aria-label="Dorsal de Ruta y Ritmo, número 042">
      <span class="bib__pin bib__pin--left" aria-hidden="true"></span>
      <span class="bib__pin bib__pin--right" aria-hidden="true"></span>
      <p class="bib__series">Diario de running</p>
      <p class="bib__number">042</p>
      <p class="bib__name">RUTA Y RITMO</p>
      <div class="bib__meta">
        <span>Nº 08</span>
        <span>Otoño 2026</span>
      </div>
      <div class="bib__barcode" aria-hidden="true"></div>
    </figure>
  </section>

  <section class="section wrap" aria-labelledby="destacado-title">
    <div class="section-head">
      <h2 id="destacado-title">Para empezar</h2>
      <a class="section-link" href="/diario/">Ver todos los artículos</a>
    </div>

    <article class="feature">
      <div class="feature__art" aria-hidden="true">
        <img
          src={`/images/articles/${destacado.id}.svg`}
          width="1200"
          height="675"
          fetchpriority="high"
          alt=""
        />
      </div>
      <div class="feature__body">
        <p class="meta">
          <a
            class="category-tag"
            href={`/diario/categoria/${categoriaDestacada.slug}/`}
            style={`--cat:${categoriaDestacada.tone}`}
          >{categoriaDestacada.name}</a>
          <span>{readingTime(destacado.body)} min de lectura</span>
        </p>
        <h3><a href={`/diario/${destacado.id}/`}>{destacado.data.title}</a></h3>
        <p>{destacado.data.description}</p>
        <a class="text-link" href={`/diario/${destacado.id}/`}>Leer la entrada</a>
      </div>
    </article>

    <AdSlot />

    <div class="start-strip" aria-label="Guías para empezar">
      <a class="start-strip__item" href="/diario/empezar-a-correr-en-8-semanas/">
        <strong>Nunca he corrido</strong>
        <span>El plan de ocho semanas que sí se puede seguir.</span>
      </a>
      <a class="start-strip__item" href="/diario/zapatillas-900-kilometros/">
        <strong>Las zapatillas tienen fecha</strong>
        <span>Señales para jubilarlas antes de que lo haga tu rodilla.</span>
      </a>
      <a class="start-strip__item" href="/diario/primera-media-maraton/">
        <strong>Primera media maratón</strong>
        <span>Doce semanas, un plan y una idea clara del ritmo.</span>
      </a>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="ultimos-title">
    <div class="section-head">
      <h2 id="ultimos-title">Últimas entradas</h2>
        <p>Guías de entrenamiento, material, salud, nutrición y carreras.</p>
    </div>

    <div class="card-grid">
      {ultimos.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>

  <section class="section routes" id="rutas" aria-labelledby="rutas-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="rutas-title">Rutas de Madrid</h2>
        <a class="section-link" href="/rutas/">Ver las cuatro fichas</a>
      </div>

      <div class="table-scroll">
        <table>
          <caption>Fichas preliminares: confirma recorrido, distancia y accesos antes de salir.</caption>
          <thead>
            <tr>
              <th scope="col">Ruta</th>
              <th scope="col" class="num">Distancia</th>
              <th scope="col" class="num">Desnivel</th>
              <th scope="col">Terreno</th>
              <th scope="col">Dificultad</th>
            </tr>
          </thead>
          <tbody>
            {rutas.map((ruta) => (
              <tr>
                <td><a class="route-name" href={`/rutas/${ruta.id}/`}>{ruta.data.title}</a></td>
                <td class="num">{ruta.data.distanceKm} km</td>
                <td class="num">+{ruta.data.elevationGain} m</td>
                <td>{ruta.data.terrain}</td>
                <td>{ruta.data.difficulty}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
